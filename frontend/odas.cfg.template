version = "2.1";
raw: {
    fS = $sample_rate; hopSize = $hop_size; nBits = 16; nChannels = $channels;
    interface: { $input_interface };
};
mapping: { map: ($mapping); };
general: {
    epsilon = 1E-20;
    size: { hopSize = $hop_size; frameSize = $frame_size; };
    samplerate: { mu = $sample_rate; sigma2 = 0.01; };
    speedofsound: { mu = $sound_speed; sigma2 = 25.0; };
    mics = ($microphones);
    spatialfilters = ({ direction = (0.0, 0.0, 1.0); angle = ($search_angles); });
    nThetas = 181; gainMin = 0.25;
};
sne: { b = 3; alphaS = 0.1; L = 150; delta = 3.0; alphaD = 0.1; };
ssl: {
    nPots = $num_potentials; nMatches = 10; probMin = 0.5;
    nRefinedLevels = 1; interpRate = 4;
    scans = ({ level = 2; delta = -1; }, { level = 4; delta = -1; });
    potential: { format = "json"; interface: { type = "file"; path = $potential_path; }; };
};
sst: {
    mode = "kalman"; add = "dynamic";
    active = ({ weight = 1.0; mu = 0.3; sigma2 = 0.0025; });
    inactive = ({ weight = 1.0; mu = 0.15; sigma2 = 0.0025; });
    sigmaR2_prob = 0.0025; sigmaR2_active = 0.0225; sigmaR2_target = 0.0025;
    Pfalse = 0.1; Pnew = 0.1; Ptrack = 0.8;
    theta_new = 0.9; N_prob = 5; theta_prob = 0.8;
    N_inactive = ($inactive); theta_inactive = 0.9;
    kalman: { sigmaQ = 0.001; };
    particle: {
        nParticles = 1000;
        st_alpha = 2.0; st_beta = 0.04; st_ratio = 0.5;
        ve_alpha = 0.05; ve_beta = 0.2; ve_ratio = 0.3;
        ac_alpha = 0.5; ac_beta = 0.2; ac_ratio = 0.2; Nmin = 0.7;
    };
    target: ();
    tracked: { format = "json"; interface: { type = "file"; path = $tracks_path; }; };
};
sss: {
    mode_sep = "$separation"; mode_pf = "$postfilter";
    gain_sep = $gain; gain_pf = $gain;
    dds: {};
    dgss: { mu = 0.01; lambda = 0.5; };
    ms: {
        alphaPmin = 0.07; eta = 0.5; alphaZ = 0.8;
        thetaWin = 0.3; alphaWin = 0.3;
        maxAbsenceProb = 0.9; Gmin = 0.01;
        winSizeLocal = 3; winSizeGlobal = 23; winSizeFrame = $frame_size;
    };
    ss: { Gmin = 0.01; Gmid = 0.9; Gslope = 10.0; };
    separated: {
        fS = $sample_rate; hopSize = $hop_size; nBits = 16;
        interface: { $separated_interface };
    };
    postfiltered: {
        fS = $sample_rate; hopSize = $hop_size; nBits = 16;
        interface: { $postfiltered_interface };
    };
};
classify: {
    frameSize = 1024; winSize = 3; tauMin = 32; tauMax = 200;
    deltaTauMax = 7; alpha = 0.3; gamma = 0.05; phiMin = 0.15; r0 = 0.2;
    category: { format = "undefined"; interface: { type = "blackhole"; }; };
};
